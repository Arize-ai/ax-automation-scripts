# ------------------------------------------------------------------
# Reverse Proxy -- example environment
# Copy to .env and fill in real values.
# ------------------------------------------------------------------

# Required: the upstream LLM gateway URL
TARGET_BASE_URL=https://ai-gateway.internal.example.com

# Token acquisition for the upstream: oauth2 | azure | static | none
AUTH_TYPE=oauth2
OAUTH2_TOKEN_URL=https://auth.internal.example.com/oauth2/token
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPE=

# Optional: token Arize must send to authenticate to the proxy
PROXY_AUTH_TOKEN=

# TLS / mTLS (paths inside the container; mount via CERTS_DIR)
# CLIENT_CERT_PATH=/app/certs/client.crt
# CLIENT_KEY_PATH=/app/certs/client.key
# REQUESTS_CA_BUNDLE=/app/certs/ca.pem

# Server
PORT=8000
REQUEST_TIMEOUT=120
LOG_LEVEL=INFO

# Debug: capture incoming requests to inspect what the client is sending.
# DUMP_REQUESTS=1 logs each request; DUMP_REQUESTS_FILE also appends JSON lines.
# DUMP_REQUESTS=1
# DUMP_REQUESTS_FILE=/app/captured_requests.jsonl
